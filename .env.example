# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE SHEET RESPONSES INTEGRATION (FOR NETLIFY & GITHUB)
# Option 1: Set a Google Apps Script Webhook URL so all votes, signups & orders update your Google Sheet in real time.
# On Netlify: Go to Site Settings > Environment Variables > Add key: VITE_GOOGLE_SHEET_WEBHOOK_URL
VITE_GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec"

# Option 2: Target Google Spreadsheet ID (For Node server)
GOOGLE_SPREADSHEET_ID="YOUR_GOOGLE_SPREADSHEET_ID"

